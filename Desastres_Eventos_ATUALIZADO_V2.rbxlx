        <Item class="LocalScript">
          <Properties>
            <string name="Name">InterfacePartida</string>
            <ProtectedString name="Source">-- INTERFACE DA PARTIDA - VOTACAO FISICA E TEMPORIZADOR COMPACTO
-- Local: StarterPlayer &gt; StarterPlayerScripts &gt; InterfacePartida (LocalScript)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local eventos = ReplicatedStorage:WaitForChild("EventosPartida")
local roundEvent = eventos:WaitForChild("RoundEvent")
local prontoEvent = eventos:WaitForChild("ClientePronto")

local playerGui = player:WaitForChild("PlayerGui")
local antiga = playerGui:FindFirstChild("InterfacePartida")
if antiga then antiga:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "InterfacePartida"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 20
gui.Parent = playerGui

local aviso = Instance.new("TextLabel")
aviso.Name = "Aviso"
aviso.AnchorPoint = Vector2.new(0.5, 0)
aviso.Size = UDim2.new(0.52, 0, 0, 27)
aviso.Position = UDim2.new(0.5, 0, 0.012, 0)
aviso.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
aviso.BackgroundTransparency = 0.12
aviso.TextColor3 = Color3.new(1, 1, 1)
aviso.TextScaled = true
aviso.Font = Enum.Font.GothamBold
aviso.Text = "Aguardando próxima votação..."
aviso.Parent = gui

local limiteTexto = Instance.new("UITextSizeConstraint")
limiteTexto.MinTextSize = 9
limiteTexto.MaxTextSize = 15
limiteTexto.Parent = aviso

local canto = Instance.new("UICorner")
canto.CornerRadius = UDim.new(0, 8)
canto.Parent = aviso

local borda = Instance.new("UIStroke")
borda.Thickness = 1
borda.Transparency = 0.55
borda.Color = Color3.fromRGB(110, 155, 210)
borda.Parent = aviso

roundEvent.OnClientEvent:Connect(function(tipo, a, b)
    if tipo == "Mensagem" then
        aviso.Text = tostring(a)
    elseif tipo == "Votacao" then
        aviso.Text = "Pise na plataforma do mapa que deseja escolher!"
    elseif tipo == "CronometroVoto" then
        aviso.Text = "VOTAÇÃO: " .. tostring(a) .. "s — pise em uma plataforma"
    elseif tipo == "FimVotacao" then
        aviso.Text = "Mapa escolhido: " .. tostring(a):gsub("_", " ")
    elseif tipo == "Desastre" then
        aviso.Text = "DESASTRE: " .. string.upper(tostring(a))
    elseif tipo == "Tremor" then
        local camera = workspace.CurrentCamera
        if camera then
            camera.CFrame = camera.CFrame * CFrame.new(math.random(-2, 2) / 10, math.random(-2, 2) / 10, 0)
        end
    end
end)

prontoEvent:FireServer()
print("[InterfacePartida] Interface compacta carregada para " .. player.Name)
</ProtectedString>
