    <Item class="StarterPlayer">
      <Properties>
        <string name="Name">StarterPlayer</string>
      </Properties>
      <Item class="StarterPlayerScripts">
        <Properties>
          <string name="Name">StarterPlayerScripts</string>
        </Properties>
        <Item class="LocalScript">
          <Properties>
            <string name="Name">InterfacePartida</string>
            <ProtectedString name="Source">-- INTERFACE DE VOTACAO - VERSAO CORRIGIDA
-- Local: StarterPlayer &gt; StarterPlayerScripts &gt; InterfacePartida (LocalScript)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local eventos = ReplicatedStorage:WaitForChild("EventosPartida")
local roundEvent = eventos:WaitForChild("RoundEvent")
local voteEvent = eventos:WaitForChild("VoteEvent")
local prontoEvent = eventos:WaitForChild("ClientePronto")

local playerGui = player:WaitForChild("PlayerGui")
local antiga = playerGui:FindFirstChild("InterfacePartida")
if antiga then antiga:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "InterfacePartida"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 20
gui.Parent = playerGui

local aviso = Instance.new("TextLabel")
aviso.Name = "Aviso"
aviso.Size = UDim2.new(0.68,0,0,34)
aviso.Position = UDim2.new(0.16,0,0.015,0)
aviso.BackgroundColor3 = Color3.fromRGB(20,20,28)
aviso.BackgroundTransparency = 0.08
aviso.TextColor3 = Color3.new(1,1,1)
aviso.TextScaled = true
aviso.Font = Enum.Font.GothamBold
local limiteTextoAviso = Instance.new("UITextSizeConstraint")
limiteTextoAviso.MinTextSize = 10
limiteTextoAviso.MaxTextSize = 20
limiteTextoAviso.Parent = aviso
aviso.Text = "Aguardando próxima votação..."
aviso.Parent = gui
Instance.new("UICorner", aviso).CornerRadius = UDim.new(0,12)

local painel = Instance.new("Frame")
painel.Name = "PainelVotacao"
painel.Size = UDim2.new(0.84,0,0,300)
painel.Position = UDim2.new(0.08,0,0.5,-150)
painel.BackgroundColor3 = Color3.fromRGB(25,25,34)
painel.Visible = false
painel.Parent = gui
Instance.new("UICorner", painel).CornerRadius = UDim.new(0,14)

local titulo = Instance.new("TextLabel")
titulo.Name = "Titulo"
titulo.Size = UDim2.new(1,-20,0,48)
titulo.Position = UDim2.new(0,10,0,5)
titulo.BackgroundTransparency = 1
titulo.Text = "VOTE NO MAPA"
titulo.TextColor3 = Color3.new(1,1,1)
titulo.Font = Enum.Font.GothamBold
titulo.TextScaled = true
titulo.Parent = painel

local lista = Instance.new("Frame")
lista.Name = "ListaMapas"
lista.Size = UDim2.new(1,-20,1,-62)
lista.Position = UDim2.new(0,10,0,55)
lista.BackgroundTransparency = 1
lista.Parent = painel

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0,6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = lista

local botoes = {}
local jaVotou = false

local function limparBotoes()
    for _, botao in ipairs(botoes) do
        botao:Destroy()
    end
    table.clear(botoes)
end

local function criarVotacao(opcoes)
    limparBotoes()
    jaVotou = false
    painel.Visible = true
    titulo.Text = "VOTE NO MAPA"

    for indice, nome in ipairs(opcoes) do
        local botao = Instance.new("TextButton")
        botao.Name = "Votar_" .. nome
        botao.Size = UDim2.new(1,0,0,48)
        botao.LayoutOrder = indice
        botao.BackgroundColor3 = Color3.fromRGB(48,92,155)
        botao.TextColor3 = Color3.new(1,1,1)
        botao.TextScaled = true
        local limiteBotao = Instance.new("UITextSizeConstraint")
        limiteBotao.MinTextSize = 12
        limiteBotao.MaxTextSize = 20
        limiteBotao.Parent = botao
        botao.Font = Enum.Font.GothamBold
        botao.Text = nome .. "  |  0 votos"
        botao.Parent = lista
        Instance.new("UICorner", botao).CornerRadius = UDim.new(0,9)

        botao.Activated:Connect(function()
            voteEvent:FireServer(nome)
            jaVotou = true
            aviso.Text = "Seu voto: " .. nome
            for _, outro in ipairs(botoes) do
                outro.BackgroundColor3 = Color3.fromRGB(48,92,155)
            end
            botao.BackgroundColor3 = Color3.fromRGB(35,145,85)
        end)

        table.insert(botoes, botao)
    end
end

roundEvent.OnClientEvent:Connect(function(tipo, a, b)
    if tipo == "Mensagem" then
        aviso.Text = tostring(a)

    elseif tipo == "Votacao" then
        criarVotacao(a)
        aviso.Text = "Escolha seu mapa!"

    elseif tipo == "CronometroVoto" then
        titulo.Text = "VOTE NO MAPA — " .. tostring(a) .. "s"

    elseif tipo == "Contagem" then
        for _, botao in ipairs(botoes) do
            local nome = string.gsub(botao.Name, "^Votar_", "")
            botao.Text = nome .. "  |  " .. tostring(a[nome] or 0) .. " votos"
        end

    elseif tipo == "FimVotacao" then
        painel.Visible = false
        aviso.Text = "Mapa vencedor: " .. tostring(a)

    elseif tipo == "Desastre" then
        aviso.Text = "⚠ DESASTRE: " .. string.upper(tostring(a)) .. " ⚠"

    elseif tipo == "Tremor" then
        local camera = workspace.CurrentCamera
        if camera then
            camera.CFrame = camera.CFrame * CFrame.new(math.random(-2,2)/8, math.random(-2,2)/8, 0)
        end
    end
end)

-- Avisa o servidor que a GUI já está pronta para receber a votação.
prontoEvent:FireServer()
print("[InterfacePartida] Interface carregada para " .. player.Name)
</ProtectedString>
